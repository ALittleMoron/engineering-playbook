#!/usr/bin/env python3
from __future__ import annotations

import argparse
import difflib
import os
import shutil
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

from agentslib import ProfileError, load_profile, output_path, render_profile


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Preview or install the generated global Codex AGENTS.md file."
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Back up and replace the target; the default is a dry run.",
    )
    parser.add_argument(
        "--codex-home",
        type=Path,
        help="Override the Codex home directory, primarily for isolated verification.",
    )
    return parser.parse_args()


def codex_home(argument: Path | None) -> Path:
    if argument is not None:
        return argument.expanduser().resolve()
    configured_home = os.environ.get("CODEX_HOME")
    if configured_home:
        return Path(configured_home).expanduser().resolve()
    return (Path.home() / ".codex").resolve()


def print_diff(current: str, replacement: str, target: Path) -> None:
    source_label = str(target) if target.exists() else "/dev/null"
    difference = difflib.unified_diff(
        current.splitlines(keepends=True),
        replacement.splitlines(keepends=True),
        fromfile=source_label,
        tofile=str(target),
    )
    sys.stdout.writelines(difference)


def next_backup_path(target: Path) -> Path:
    timestamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    candidate = target.with_name(f"{target.name}.backup-{timestamp}")
    counter = 1
    while candidate.exists():
        candidate = target.with_name(f"{target.name}.backup-{timestamp}.{counter}")
        counter += 1
    return candidate


def atomic_write(target: Path, content: str) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{target.name}.", dir=target.parent
    )
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as target_file:
            target_file.write(content)
            target_file.flush()
            os.fsync(target_file.fileno())
        os.chmod(temporary_path, 0o644)
        os.replace(temporary_path, target)
    finally:
        temporary_path.unlink(missing_ok=True)


def main() -> int:
    arguments = parse_arguments()
    repository = Path(__file__).resolve().parents[1]

    try:
        profile = load_profile(repository, "global")
        expected = render_profile(repository, profile)
        generated = output_path(repository, profile)
        if generated.is_symlink() or not generated.is_file():
            raise ProfileError(
                "generated global profile is missing; run scripts/build-agents global"
            )
        if generated.read_text(encoding="utf-8") != expected:
            raise ProfileError(
                "generated global profile is stale; run scripts/build-agents global"
            )

        home_directory = codex_home(arguments.codex_home)
        target = home_directory / "AGENTS.md"
        if target.is_symlink():
            raise ProfileError(f"refusing to replace symlink: {target}")
        if target.exists() and not target.is_file():
            raise ProfileError(f"target is not a regular file: {target}")

        current = target.read_text(encoding="utf-8") if target.is_file() else ""
        if current == expected:
            print(f"already installed: {target}")
            return 0

        print_diff(current, expected, target)
        if not arguments.apply:
            print("dry run: no files changed; rerun with --apply to install")
            return 0

        home_directory.mkdir(parents=True, exist_ok=True)
        if target.is_file():
            backup = next_backup_path(target)
            shutil.copy2(target, backup)
            print(f"backup: {backup}")
        atomic_write(target, expected)
        print(f"installed: {target}")
    except (OSError, UnicodeError, ProfileError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
